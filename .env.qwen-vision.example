# Copy to .env.qwen-vision and fill in the values for this cluster.
QWEN_VISION_IMAGE=local/dspark-vllm-gx10:qwen-flashinfer-0.6.13
QWEN_VISION_MODEL=RedHatAI/Qwen3.5-9B-quantized.w4a16
QWEN_VISION_SERVED_MODEL=qwen3.5-9b-vision
QWEN_VISION_PORT=8890
QWEN_VISION_MAX_MODEL_LEN=32768
QWEN_VISION_MAX_NUM_SEQS=5
QWEN_VISION_MAX_NUM_BATCHED_TOKENS=2048
QWEN_VISION_GPU_MEMORY_UTILIZATION=0.05
QWEN_VISION_KV_CACHE_MEMORY_BYTES=367001600
QWEN_VISION_KV_CACHE_DTYPE=fp8

# Set these per node before starting Compose.
NODE_RANK=0
MASTER_ADDR=CHANGE_ME_HEAD_FABRIC_IP
MASTER_PORT=25100
NCCL_IB_HCA=rocep1s0f1
NCCL_SOCKET_IFNAME=enp1s0f1np1
HF_CACHE=/home/YOUR_USERNAME/.cache/huggingface
QWEN_WORKER_HF_CACHE=/home/YOUR_USERNAME/.cache/huggingface
QWEN_SYNC_CACHE=1
